# Copy to .env (git-ignored) and fill in. Contains NO secrets - Learner Lab credentials come from
# the lab's "AWS Details" panel / your AWS CLI profile, never from this file.
AWS_REGION=us-east-1
LAB_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/LabRole
STACK_NAME=roomready-dev
STAGE=dev
# Comma-separated caller ids (IAM ARNs) allowed to call /admin routes on AWS.
ADMIN_USERS=
# Demo-only fallback identity header (X-Demo-User). Keep false unless presenting in class.
DEMO_ALLOW_HEADER_IDENTITY=false
